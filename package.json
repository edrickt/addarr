{
	"name": "addarr",
	"version": "0.2.0",
	"private": true,
	"license": "MIT",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "node --test src/lib/arr/add-resource.test.ts src/lib/arr/downloads.test.ts src/lib/arr/files.test.ts src/lib/arr/presentation.test.ts",
		"start": "npm install --no-audit --no-fund && npm run build && node scripts/service.mjs start",
		"start:foreground": "npm install --no-audit --no-fund && npm run build && node scripts/serve.mjs",
		"serve": "node scripts/serve.mjs",
		"stop": "node scripts/service.mjs stop",
		"restart": "node scripts/service.mjs restart",
		"status": "node scripts/service.mjs status",
		"logs": "node scripts/service.mjs logs",
		"open": "node scripts/service.mjs open",
		"uninstall": "node scripts/service.mjs uninstall",
		"icons": "node scripts/icons.mjs"
	},
	"devDependencies": {
		"@sveltejs/adapter-node": "^5.2.0",
		"@sveltejs/kit": "^2.20.0",
		"@sveltejs/vite-plugin-svelte": "^5.0.0",
		"@types/node": "^26.4.1",
		"svelte": "^5.25.0",
		"svelte-check": "^4.1.0",
		"typescript": "^5.8.0",
		"vite": "^6.2.0"
	},
	"dependencies": {
		"@fontsource-variable/inter": "^5.3.0",
		"bonjour-service": "^1.4.4"
	}
}
